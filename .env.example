# ==============================================================================
# Krishi Mitra (ಕೃಷಿ ಮಿತ್ರ) — Backend Environment Configuration Example
# ==============================================================================

# Application Environment (local, staging, production)
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
ENABLE_PUBLIC_DOCS=true

# Cryptographic Keys (Distinct, dedicated 256-bit secrets for key separation)
# Replace these with unique, randomly generated 64-character hex strings in production
APP_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_SECRET_KEY=replace-with-a-secure-jwt-signing-key-at-least-32-chars
ENCRYPTION_KEY=replace-with-a-secure-phone-encryption-key-at-least-32-chars
BLIND_INDEX_KEY=replace-with-a-secure-blind-indexing-key-at-least-32-chars
ENCRYPTION_KEY_PREVIOUS=

# PostgreSQL Database Configuration (Port 5432)
# Format: postgresql+psycopg://username:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://krishi_app:krishi_mitra_dev_pass@127.0.0.1:5432/krishi_mitra
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_TIMEOUT_SECONDS=5.0

# Redis Cache & Token Denylist Store (Port 6379)
REDIS_URL=redis://127.0.0.1:6379/0

# Ollama NLU / LLM Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=30.0
OLLAMA_MAX_RETRIES=1
OLLAMA_TEMPERATURE=0.1

# Speech Recognition (ASR) Configuration
# Options for ASR_PROVIDER: mock (default for local dev/testing), indic_conformer (production with NeMo service)
ASR_PROVIDER=mock
ASR_SERVICE_URL=http://127.0.0.1:8001
ASR_BASE_URL=http://127.0.0.1:8001
ASR_TIMEOUT_SECONDS=15.0
ASR_MODEL_VERSION=ai4bharat/indicconformer_asr_kn_v1

# Speech Synthesis (TTS) Configuration
# Options for TTS_PROVIDER: mock (default for local dev/testing), indic_tts (production with Indic-TTS service)
TTS_PROVIDER=mock
TTS_SERVICE_URL=http://127.0.0.1:8002
TTS_BASE_URL=http://127.0.0.1:8002
TTS_TIMEOUT_SECONDS=15.0
TTS_VOICE_GENDER=female
TTS_MODEL_VERSION=ai4bharat/indic_tts_kn_v1

# Audio Storage & Lifecycle (Ephemeral Storage with TTL)
AUDIO_TEMP_DIR=./.runtime/audio
AUDIO_MAX_BYTES=15728640
AUDIO_MAX_SECONDS=60
AUDIO_RESPONSE_TTL_SECONDS=600

# Authentication & Session Token Parameters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_ROTATION_GRACE_SECONDS=30
AUTH_RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REGISTER_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_REGISTER_WINDOW_SECONDS=300
AUTH_LOCKOUT_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15

# CORS Allowed Origins (Web browser frontend endpoints)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1
ALLOWED_HOSTS=*

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=text
