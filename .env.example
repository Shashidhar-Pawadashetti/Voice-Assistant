# Krishi Mitra Backend Configuration

# Application Environment (local, staging, production)
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=replace-me-with-a-secure-random-secret-key-at-least-32-chars

# PostgreSQL Database URL
# Format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://krishi_app:krishi_mitra_dev_pass@127.0.0.1:5432/krishi_mitra
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_TIMEOUT_SECONDS=5.0

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=30.0
OLLAMA_MAX_RETRIES=1
OLLAMA_TEMPERATURE=0.1

# Speech / Audio Configuration (M1+)
ASR_PROVIDER=indicconformer
ASR_BASE_URL=http://127.0.0.1:8001
TTS_PROVIDER=indic_tts
TTS_BASE_URL=http://127.0.0.1:8002
AUDIO_TEMP_DIR=./.runtime/audio
AUDIO_MAX_BYTES=15728640
AUDIO_MAX_SECONDS=60
AUDIO_RESPONSE_TTL_SECONDS=600

# CORS Origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
